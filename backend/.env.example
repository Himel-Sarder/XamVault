# Copy to backend/.env and fill in. NEVER commit the real .env.

# ---------- Application ----------
ENV=development
# ENV=production makes the app refuse to start with a weak JWT secret or a SQLite URL.

# ---------- Database ----------
# Render → your PostgreSQL instance → "External Database URL".
# postgres:// and postgresql:// are both accepted and normalised to postgresql+psycopg://
DATABASE_URL=postgresql://uniexam:password@dpg-xxxxxxxx.oregon-postgres.render.com/uniexam
# Local fallback used by the tests when nothing is set:
# DATABASE_URL=sqlite+pysqlite:///./uniexam_dev.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false

# ---------- JWT ----------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- CORS ----------
# Comma-separated origins. Native Flutter builds send no Origin header and do not need an
# entry here; Flutter Web does.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000

# ---------- Reporting ----------
# Printed at the head of exported PDF and Excel reports.
UNIVERSITY_NAME=Your University

# ---------- Uploads (used from Phase 5) ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ---------- Rate limiting ----------
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10/minute
REFRESH_RATE_LIMIT=30/minute
DEFAULT_RATE_LIMIT=300/minute

# ---------- First administrator (python -m app.utils.seed) ----------
FIRST_ADMIN_USER_ID=admin
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=System Administrator
