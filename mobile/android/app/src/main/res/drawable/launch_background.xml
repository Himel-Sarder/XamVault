<?xml version="1.0" encoding="utf-8"?>
<!-- The window behind the app while the process starts.

     Deep navy rather than white: the Flutter splash that replaces it paints the same
     colour, so the handover is invisible. A white window here flashes for a frame and
     then goes dark, which reads as a fault.

     No logo. The Flutter splash animates one in from nothing, and a static bitmap at a
     different size would visibly jump the moment Flutter takes over. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
</layer-list>
